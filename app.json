{
  "expo": {
    "jsEngine": "jsc",
    "name": "bada-on-app",
    "slug": "badaon",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#1764BE",
      "resizeMode": "cover"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "바다온은 현재 위치를 기반으로 근처 장소들의 기상 정보를 제공하기 위해 위치 정보가 필요합니다.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "바다온은 현재 위치를 기반으로 근처 장소들의 기상 정보를 제공하기 위해 위치 정보가 필요합니다.",
        "NSUserNotificationUsageDescription": "바다온은 날씨 알림과 중요 소식을 전달하기 위해 알림 권한이 필요합니다.",
        "NSRemoteNotificationUsageDescription": "바다온은 날씨 알림과 중요 소식을 전달하기 위해 알림 권한이 필요합니다."
      },
      "bundleIdentifier": "com.hanbeulyou.badaonapp",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1764BE"
      },
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "package": "com.hanbeulyou.badaonapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3268ff43-463c-4cd0-b408-6194697ab0ed"
      }
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "owner": "badaon"
  }
}
